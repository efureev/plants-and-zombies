{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:context_entity_type",
    "cases": [
      {
        "when": "minecraft:player",
        "model": {
          "type": "minecraft:condition",
          "property": "minecraft:using_item",
          "on_false": {
            "type": "sproutsquad:door_shield_model",
            "model": "sproutsquad:item/door_shield/door_shield"
          },
          "on_true": {
            "type": "sproutsquad:door_shield_model",
            "model": "sproutsquad:item/door_shield/door_shield_blocking"
          }
        }
      }
    ],
    "fallback": {
      "type": "sproutsquad:door_shield_model",
      "model": "sproutsquad:item/door_shield/door_shield_blocking"
    }
  }
}