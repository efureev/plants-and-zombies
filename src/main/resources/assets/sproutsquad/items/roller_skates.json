{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": "thirdperson_righthand",
        "model": {
          "type": "minecraft:model",
          "model": "sproutsquad:block/roller_skate_right"
        }
      },
      {
        "when": "thirdperson_lefthand",
        "model": {
          "type": "minecraft:model",
          "model": "sproutsquad:block/roller_skate_left"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "sproutsquad:item/roller_skates"
    }
  }
}